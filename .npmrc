# The API client is generated from the Smithy model in `pigeon` and published
# to GitHub Packages, so it is not on the public registry.
#
# The token needs `read:packages` and comes from the environment rather than
# living here — a token in a committed file is a token in every clone.
#   export NODE_AUTH_TOKEN=$(gh auth token)   # needs the read:packages scope
@operation-pigeon:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
